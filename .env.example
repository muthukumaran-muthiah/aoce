# Copy to .env and fill in ANTHROPIC_API_KEY. Never commit .env (it is gitignored).
# `tilt up` reads only ANTHROPIC_API_KEY from here; the agent's other settings for the
# cluster are in AGENT_SETTINGS in the Tiltfile. The AOCE_* values below are for running
# the agent outside the cluster (uvicorn on your machine) against Tilt's port-forwards.
ANTHROPIC_API_KEY=
AOCE_MODEL=claude-haiku-5-5
AOCE_EFFORT=high
AOCE_PROMETHEUS_URL=http://localhost:9090
AOCE_OPENSEARCH_URL=http://localhost:9200
AOCE_JAEGER_URL=http://localhost:8080/jaeger/ui
AOCE_DATABASE_URL=postgresql://monitoring_user:monitoring_password@localhost:15432/astronomy_db
# Investigation limits (AOCE-29)
AOCE_INVESTIGATION_MAX_STEPS=12
AOCE_INVESTIGATION_TIMEOUT_S=300
AOCE_INVESTIGATION_TOKEN_BUDGET=300000
AOCE_TOOL_TIMEOUT_S=30
AOCE_MAX_CONCURRENT_INVESTIGATIONS=2
AOCE_MAX_INCIDENTS=200
